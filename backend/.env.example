# Environment Variables - ReachInbox Scheduler
# Copy this file to .env and fill in your values.

# ─── Application ──────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
RATE_LIMIT_WINDOW_SECONDS=3600

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include: http://localhost:5001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── SMTP / Ethereal ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Minimum delay between individual email sends in milliseconds (default: 2000)
EMAIL_SEND_DELAY_MS=2000

# ─── Slack Integration ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Slack OAuth ──────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5001/auth/slack/callback

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails