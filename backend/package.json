{
  "name": "reachinbox-scheduler",
  "version": "1.0.0",
  "description": "ReachInbox Hiring Assignment – Production-ready backend foundation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "ts-node --transpile-only src/db/migrate.ts",
    "db:test": "ts-node --transpile-only src/scripts/testDb.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/emailWorker.ts",
    "queue:test": "ts-node --transpile-only src/scripts/testQueue.ts",
    "email:test": "ts-node --transpile-only src/scripts/testEmail.ts",
    "rate-limit:test": "ts-node --transpile-only src/scripts/testRateLimit.ts",
    "recovery:test": "ts-node --transpile-only src/scripts/testRecovery.ts",
    "slack:test": "ts-node --transpile-only src/scripts/testSlack.ts",
    "slack-integration:test": "ts-node --transpile-only src/scripts/testSlackIntegration.ts",
    "search:test": "ts-node --transpile-only src/scripts/testSearch.ts",
    "search:reindex": "ts-node --transpile-only src/scripts/reindexEmails.ts",
    "sender:test": "ts-node --transpile-only src/scripts/testMultipleSenders.ts",
    "send-delay:test": "ts-node --transpile-only src/scripts/testSendDelay.ts",
    "slack-oauth:test": "ts-node --transpile-only src/scripts/testSlackOAuth.ts",
    "scheduled-email:test": "ts-node --transpile-only src/scripts/testScheduledEmail.ts",
    "scheduled-recovery:test": "ts-node --transpile-only src/scripts/testScheduledRecovery.ts",
    "load:test": "ts-node --transpile-only src/scripts/loadTest.ts"
  },
  "keywords": [
    "reachinbox",
    "scheduler",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "@elastic/elasticsearch": "^8.12.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.11.6",
    "bullmq": "^6.3.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "ioredis": "^5.3.2",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
